<XMLDB PATH="local/lumen10_voiceaccess/db" VERSION="20261103" COMMENT="VoiceAccess personal settings; never audio or transcripts">
  <TABLES>
    <TABLE NAME="local_lumen10_voiceaccess_user" COMMENT="Personal accessibility preferences and encrypted API credential">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="preferences" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="provider" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="none"/>
        <FIELD NAME="model" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="gpt-6-luna"/>
        <FIELD NAME="apikey" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="consent" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="quotaused" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="quotaday" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="1970-01-01"/>
        <FIELD NAME="lastrequest" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userfk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES><INDEX NAME="useruniq" UNIQUE="true" FIELDS="userid"/></INDEXES>
    </TABLE>
    <TABLE NAME="local_lumen10_voiceaccess_access" COMMENT="Restricted self-declaration and analyst approval; never medical documents">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="declaration" TYPE="char" LENGTH="20" NOTNULL="true"/>
        <FIELD NAME="active" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="userfk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="useruniq" UNIQUE="true" FIELDS="userid"/></INDEXES>
    </TABLE>
    <TABLE NAME="local_lumen10_voiceaccess_device" COMMENT="Hashed private single-use pairing and revocable device credentials">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="tokenhash" TYPE="char" LENGTH="64" NOTNULL="true"/>
        <FIELD NAME="kind" TYPE="char" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="expires" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="used" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="userfk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="tokenuniq" UNIQUE="true" FIELDS="tokenhash"/><INDEX NAME="expiryidx" UNIQUE="false" FIELDS="expires"/></INDEXES>
    </TABLE>
    <TABLE NAME="local_lumen10_voiceaccess_aiusage" COMMENT="Aggregated daily AI consumption per person; never phrases, responses or audio">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="day" TYPE="char" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="provider" TYPE="char" LENGTH="20" NOTNULL="true"/>
        <FIELD NAME="model" TYPE="char" LENGTH="100" NOTNULL="true"/>
        <FIELD NAME="requests" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="errors" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="prompttokens" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="outputtokens" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="dayuserprov" UNIQUE="true" FIELDS="day, userid, provider, model"/></INDEXES>
    </TABLE>
    <TABLE NAME="local_lumen10_voiceaccess_live" COMMENT="Thirty day operational session ledger; no audio, transcripts, URLs or credentials">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="sessionhash" TYPE="char" LENGTH="64" NOTNULL="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="usageid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="expires" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="lastseen" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="ended" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="reason" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending"/>
        <FIELD NAME="connectms" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="firstaudioms" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="inputtokens" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="outputtokens" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="actions" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="actionerrors" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="rejected" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="userfk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/></KEYS>
      <INDEXES>
        <INDEX NAME="sessionuniq" UNIQUE="true" FIELDS="sessionhash"/>
        <INDEX NAME="activeidx" UNIQUE="false" FIELDS="ended, expires"/>
        <INDEX NAME="createdidx" UNIQUE="false" FIELDS="timecreated"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>

