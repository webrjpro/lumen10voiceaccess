<section class="l10va-readiness" aria-labelledby="l10va-readiness-title">
    <div class="l10va-readiness-heading">
        <div><h2 id="l10va-readiness-title">{{#str}}readinesstitle, local_lumen10_voiceaccess{{/str}}</h2>
        <p>{{#str}}readinessintro, local_lumen10_voiceaccess{{/str}}</p></div>
        <button type="button" class="btn btn-secondary" id="l10va-device-check">{{#str}}checkdevice, local_lumen10_voiceaccess{{/str}}</button>
    </div>
    <div class="l10va-readiness-grid">
        <article><h3>{{#str}}deviceheading, local_lumen10_voiceaccess{{/str}}</h3>
            <ul id="l10va-device-results" aria-live="polite" aria-atomic="true">
                <li>{{#str}}deviceunchecked, local_lumen10_voiceaccess{{/str}}</li>
            </ul>
        </article>
        <article><h3>{{#str}}aiheading, local_lumen10_voiceaccess{{/str}}</h3>
            <p class="l10va-readiness-state">{{aistatus}}</p>
            <p>{{#str}}aistatusnote, local_lumen10_voiceaccess{{/str}}</p>
            <a href="#id_ai">{{#str}}reviewai, local_lumen10_voiceaccess{{/str}}</a>
        </article>
    </div>
    <p class="l10va-readiness-footnote">{{#str}}diagnosticprivacy, local_lumen10_voiceaccess{{/str}}</p>
</section>
